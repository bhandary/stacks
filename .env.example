# Local default matches scripts/verify/doctor.sh
DATABASE_URL=postgres://stacks:stacks@127.0.0.1:5432/stacks

# Optional. Unset keeps Google Books keyless (shared anonymous quota; often HTTP 429).
# Create a key in Google Cloud Console: enable the Books API, then create an API key.
# GOOGLE_BOOKS_API_KEY=

# Sign-in. See AUTH.md. Leave the Google values empty until the OAuth client exists.
# AUTH_URL must match the browser origin. Production is the Railway URL below.
AUTH_URL=http://localhost:43177
# openssl rand -base64 32
# AUTH_SECRET=
# AUTH_GOOGLE_ID=
# AUTH_GOOGLE_SECRET=
# Production AUTH_URL=https://stacks-production-8e25.up.railway.app
# Do not set STACKS_AUTH_TEST_OIDC outside local tests.

# Railway injects PORT. Next.js reads it automatically.
# PORT=3000
