# Local default matches scripts/verify/doctor.sh
DATABASE_URL=postgres://stacks:stacks@127.0.0.1:5432/stacks

# Optional. Unset keeps Google Books keyless (shared anonymous quota; often HTTP 429).
# Create a key in Google Cloud Console: enable the Books API, then create an API key.
# GOOGLE_BOOKS_API_KEY=

# Railway injects PORT. Next.js reads it automatically.
# PORT=3000
